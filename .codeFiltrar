def simplify(ficheiro_entrada, ficheiro_saida):
    with open(ficheiro_entrada, 'r') as f_in, open(ficheiro_saida, 'w') as f_out:
        for linha in f_in:
            if linha.startswith('>'):

                partes = linha.strip().split()
                if len(partes) >= 3:
                    especie = partes[1] + "_"+ partes[2]
                    f_out.write(f'>{especie}\n')
                else:
                    f_out.write(linha)  # caso a linha não tenha o formato esperado
            else:
                f_out.write(linha)
